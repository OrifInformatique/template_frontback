# spring.application.name=Backend-template

### Tomcat configuration ###
# server.port=${PORT:9000}
 
### Spring profile ###
# Environnment is set in `.env`
# Set to `dev` by default if none found.
# spring.profiles.active=${ENVIRONMENT:dev}
# Prevent the app from running without a set environnment
# spring.main.allow-bean-definition-overriding=false
 
### Database connection ###
# spring.datasource.url=
# spring.datasource.username=
# spring.datasource.password=
  
### default security credentials ###
# spring.security.user.name=
# spring.security.user.password=

