        <mxCell id="zhJdcgPYJChfJMvGsZkv-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Les couches d&#39;un package java Spring&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Les appels se font toujours depuis une couche vers la couche qui lui est immédiatement inférieure.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Une couche n&#39;a jamais &quot;connaissance&quot; des couches qui lui sont supérieures (elle ne les appelle jamais)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Une couche ne fait jamais d&#39;appel direct vers une couche inférieur qui n&#39;est pas juste en-dessous d&#39;elle (ne &quot;court-circuite&quot; pas les couches)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Les données transitent entre les couches sous différents formats&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="960" x="160" y="80" as="geometry" />
        </mxCell>
