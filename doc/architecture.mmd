id: a4c1f6ef-73d3-499e-bd86-38679bf3369c
---
architecture-beta
    group frontend(cloud)[Frontend]
        service react(logos:react)[React App] in frontend

    group backend(cloud)[Backend]
        service backendAuthAPI(internet)[Authentication API] in backend
        service backendSpring(logos:spring)[Spring App] in backend
        service backendDB(database)[Database] in backend

        backendAuthAPI:B -- T:backendSpring
        backendSpring:B -- T:backendDB
    
    group auth(cloud)[Spring Auth]
        service registerAPI(internet)[register] in auth
        service loginAPI(internet)[login] in auth
        service refreshAPI(internet)[refresh] in auth
        service springAuth(logos:spring)[Spring App] in auth
        service authDB(database)[Database] in auth

        junction authRightTop in auth
        junction authRightCenter in auth
        junction authRightBottom in auth

        authRightTop:B -- T:authRightCenter
        authRightCenter:B -- T:authRightBottom
        
        registerAPI:R -- L:authRightTop
        loginAPI:R -- L:authRightCenter
        refreshAPI:R -- L:authRightBottom

        authRightCenter:R -- L:springAuth
        springAuth:R -- L:authDB

    react:B -- T:backendAuthAPI
    backendSpring:R -- L:registerAPI
    backendSpring:R -- L:loginAPI
    backendSpring:R -- L:refreshAPI